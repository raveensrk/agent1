#!/bin/sh
# The todo skill's CLI: the elisp implementation, under Emacs.
#   scripts/todo <verb> [args]
#   scripts/todo --warm <verb> [args]
#
# -h and --help work here like everywhere else: the verb table in todo.el prints
# the main help, and `scripts/todo <verb> --help' prints that verb's help. This
# wrapper only resolves emacs and emacsclient and passes the arguments through,
# plain or to the warm daemon, so the help text stays in one place.
#
# Plain calls start Emacs and quit. --warm keeps one Emacs up (socket
# todo-skill, or TODO_SKILL_SOCKET) and sends the same verb to it.
dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
el="$dir/todo.el"

# A GUI caller - the Main Quest window - inherits launchd's minimal PATH, which
# has no emacs or emacsclient, so both are resolved by absolute path first.
find_bin() {
  for candidate in "$@"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

EMACS=$(find_bin /Applications/Emacs.app/Contents/MacOS/Emacs "$(command -v emacs 2>/dev/null)") || {
  echo "todo: no emacs found: install Emacs.app in /Applications or put emacs on PATH" >&2
  exit 1
}
EMACSCLIENT=$(find_bin /Applications/Emacs.app/Contents/MacOS/bin/emacsclient \
                      "$(command -v emacsclient 2>/dev/null)") || {
  echo "todo: no emacsclient found next to $EMACS" >&2
  exit 1
}

if [ "${1:-}" != "--warm" ]; then
  exec "$EMACS" -Q --batch -l "$el" -- "$@"
fi
shift

socket=${TODO_SKILL_SOCKET:-todo-skill}

warm_up() {
  # The warm contract: the file on disk is the daemon's version. A daemon that
  # predates the current todo.el is stale, so this check restarts it.
  stamp=$(stat -f %m "$el")
  "$EMACSCLIENT" -s "$socket" --eval '(todo-warm-stamp)' 2>/dev/null | grep -q "\"$stamp\"$"
}

start_log="${TMPDIR:-/tmp}/todo-warm-start-$socket.log"

if ! warm_up; then
  if "$EMACSCLIENT" -s "$socket" --eval t >/dev/null 2>&1; then
    "$EMACSCLIENT" -s "$socket" --eval '(kill-emacs)' >/dev/null 2>&1 || true
    sock="${TMPDIR:-/tmp}/emacs$(id -u)/$socket"
    i=0
    while [ -e "$sock" ]; do
      i=$((i + 1))
      [ "$i" -gt 50 ] && break
      sleep 0.1
    done
  fi
  "$EMACS" -Q --daemon="$socket" -l "$el" >"$start_log" 2>&1 || true
  i=0
  while ! warm_up; do
    i=$((i + 1))
    if [ "$i" -gt 50 ]; then
      # Print why, not just that: the reason used to go to /dev/null here.
      echo "todo: warm Emacs did not start (emacs: $EMACS)" >&2
      [ -s "$start_log" ] && cat "$start_log" >&2
      exit 1
    fi
    sleep 0.1
  done
  rm -f "$start_log"
fi

tmp=${TODO_WARM_TMP:-$HOME/tmp}
mkdir -p "$tmp"
args=$(mktemp "$tmp/todo-warm-args.XXXXXX")
out=$(mktemp "$tmp/todo-warm-out.XXXXXX")
err=$(mktemp "$tmp/todo-warm-err.XXXXXX")
if [ "$#" -gt 0 ]; then
  printf '%s\0' "$@" > "$args"
else
  : > "$args"
fi

esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
here=$(pwd)
code=$("$EMACSCLIENT" -s "$socket" --eval "(todo-warm-write \"$(esc "$args")\" \"$(esc "$out")\" \"$(esc "$err")\" \"$(esc "$here")\")")
status=$?
cat "$out"
cat "$err" >&2
rm -f "$args" "$out" "$err"
if [ "$status" -ne 0 ]; then
  echo "todo: warm Emacs rejected the call" >&2
  exit 1
fi
code=$(printf '%s' "$code" | tr -cd '0-9')
exit "${code:-1}"
