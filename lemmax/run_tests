#!/usr/bin/env bash
# run_tests - lemmax's ERT tests, each in its own Emacs, as many at a time as
# the machine has cores, at most 10 (RT-12); a test tagged alone, one that
# times itself, runs after them, by itself. LEMMAX_TEST_JOBS sets how many.
#
# usage: run_tests [--addresses | --only ADDRESS] [-h|--help|help]
#   (none)          run every test; print PASS, FAIL or TIMEOUT per test, then the totals
#   --addresses     print each test's address, as ert/<name>, and run nothing
#   --only ADDRESS  run that one test
# Each test has 10 s, or what its timeout-N tag says; a test over its time is
# stopped and reported as TIMEOUT, and the rest still run.
# LEMMAX_TESTS_FILE picks another tests file; LEMMAX_TEST_TIMEOUT the default time.
# Each test adds a line to lemmax/test-times.log, git ignores it: RESULT ADDRESS
# DAY START END SECONDS s, local times; a full run then adds RUN run_tests and
# its own. LEMMAX_TEST_LOG names another log file.
# Test repos go under $TMPDIR, else /tmp, and are deleted after each test;
# LEMMAX_KEEP_TMP=1 keeps them. A test stopped for TIMEOUT may leave its own.
# lemma: 01a20336-c75e-78ac-bf5e-7a72262f73e6
# Exit 0 when every test passed, 1 otherwise.
# example: lemmax/run_tests --only ert/lemmax-list-table
set -uo pipefail
[ "${BASH_VERSINFO[0]}" -ge 5 ] || { echo "run_tests: needs Bash 5 or newer, this is $BASH_VERSION" >&2; exit 1; }
# lemma: 01a203c1-983f-77e1-a367-92eb7cba2954
# Each test runs lemmax in its own Emacs (rt-run); rt-run-proc runs the launcher.
# lemma: RT-12
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
tests="${LEMMAX_TESTS_FILE:-$here/lemmax_tests.el}"
default="${LEMMAX_TEST_TIMEOUT:-10}"

case "${1:-}" in
-h|--help|help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" | sed '/^set /d'; exit 0;;
esac

# "name seconds" per test.
roster() {
	emacs -Q --batch -l "$here/ert_roster.el" -l "$tests" --eval "(lemmax-tests-roster $default)" 2>/dev/null
}

# lemma: 01a20f83-6f84-71f0-93ea-566e27f59148
log_file="${LEMMAX_TEST_LOG:-$here/test-times.log}"
# Microseconds since the epoch, from Bash 5's clock.
now() { local t="${EPOCHREALTIME/[,.]/}"; echo "$t"; }
# One line, RESULT NAME START END: day, times and run time, appended by one write.
log_line() {
	local d=$(( ($4 - $3 + 50000) / 100000 )) day end line
	printf -v day '%(%Y-%m-%d %H:%M:%S)T' $(( $3 / 1000000 ))
	printf -v end '%(%H:%M:%S)T' $(( $4 / 1000000 ))
	printf -v line '%s %s %s %s %d.%d s\n' "$1" "$2" "$day" "$end" $(( d / 10 )) $(( d % 10 ))
	printf '%s' "$line" 2>/dev/null >>"$log_file" || true
}

# Run a command for at most SECONDS; kill it and return 142 when it runs over.
with_timeout() { # seconds command...
	local secs="$1" pid watcher rc; shift
	"$@" & pid=$!
	( sleep "$secs" & s=$!; trap 'kill $s 2>/dev/null; exit 0' TERM; wait $s; kill -9 $pid 2>/dev/null ) >/dev/null 2>&1 &
	watcher=$!
	wait $pid; rc=$?
	if kill -0 $watcher 2>/dev/null; then kill $watcher 2>/dev/null; wait $watcher 2>/dev/null
	else rc=142; fi
	return $rc
}

run_one() { # name seconds
	local log start rc
	start="$(now)"
	log="$(with_timeout "$2" emacs -Q --batch -l "$here/ert_roster.el" -l "$tests" \
		--eval "(ert-run-tests-batch-and-exit '$1)" 2>&1)"
	rc=$?
	case $rc in 0) log_line PASS "ert/$1" "$start" "$(now)" ;; 142) log_line TIMEOUT "ert/$1" "$start" "$(now)" ;;
	*) log_line FAIL "ert/$1" "$start" "$(now)" ;; esac
	case $rc in
	0) echo "PASS ert/$1" ;;
	142) echo "TIMEOUT ert/$1 (over $2 s)" ;;
	*) echo "FAIL ert/$1"; printf '%s\n' "$log" | grep -E 'FAILED|Test .* condition|^ +\(' | head -20 | sed 's/^/    /' ;;
	esac
}

case "${1:-}" in
--addresses) roster | awk '{print "ert/" $1}'; exit 0 ;;
--one) run_one "$2" "$3"; exit 0 ;;
--only)
	name="${2#ert/}"
	secs="$(roster | awk -v n="$name" '$1 == n {print $2}')"
	[ -n "$secs" ] || { echo "run_tests: no test $2" >&2; exit 1; }
	out="$(run_one "$name" "$secs")"; echo "$out"
	[[ "$out" == PASS* ]]; exit $? ;;
"") ;;
*) echo "run_tests: unknown option $1; see run_tests --help" >&2; exit 1 ;;
esac

# A test tagged alone, one that times a run, runs after the rest, by itself, so
# no load slows it. The rest start longest first, so a long one, as the
# mutation test, does not start last.
cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 8)"
jobs="${LEMMAX_TEST_JOBS:-$(( cores < 10 ? cores : 10 ))}"
run_start="$(now)"
list="$(roster)"
out="$(awk '$3 != "alone" {print $1, $2}' <<<"$list" | sort -k2,2nr -s | xargs -P "$jobs" -n 2 "$0" --one)"
while read -r name secs _; do
	out+=$'\n'"$(run_one "$name" "$secs")"
done < <(awk '$3 == "alone"' <<<"$list")
printf '%s\n' "$out"
pass=$(grep -c '^PASS' <<<"$out"); total=$(grep -cE '^(PASS|FAIL|TIMEOUT)' <<<"$out")
log_line RUN run_tests "$run_start" "$(now)"
echo "lemmax tests: $pass of $total passed"
[ "$pass" -eq "$total" ]
