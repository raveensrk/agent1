#!/bin/sh
# pre-commit and pre-push: the harness-agnostic half of the commit block.
#
# Active for every repo at once with:
#
#     git config --global core.hooksPath ~/repos/agent1/harness/githooks
#
# A repo that sets its own core.hooksPath wins over the global one, so its own
# hook has to chain this script instead. raveenkumar.xyz does.
#
# The decision is in commit_block.py, so the git hook, the Claude Code hook,
# the Codex hook, the Cursor hook and the pi guard all reach the same verdict.
here=$(cd "$(dirname "$0")" && pwd)
exec python3 "$here/../guards/commit_block.py" --git "$(basename "$0")"
