#!/usr/bin/env bash
# pre-commit - run the repo's own hook.
#
# Runs the repo's own .git/hooks/pre-commit, which the global core.hooksPath hides.
#
# usage: pre-commit [-h|--help|help]   (git passes no arguments)
# Bypass once, deliberately: git commit --no-verify
set -uo pipefail
case "${1:-}" in -h|--help|help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" | sed '/^set /d'; exit 0;; esac
own="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$own" ] && [ "$(readlink -f "$own")" != "$(readlink -f "$0")" ]; then
	exec "$own" "$@"
fi
exit 0
