#!/usr/bin/env bash
# pre-commit - run lemmax's pre-commit, then the repo's own hook.
#
# lemmax lives in its own repo now (~/repos/lemmax). Its hook refuses staged theory
# changes that break the theory's rules, in repos that opt in; every other repo
# passes at once. Then this runs the repo's own .git/hooks/pre-commit, which the
# global core.hooksPath hides. With no lmx on PATH, the lemmax step is skipped.
#
# usage: pre-commit [-h|--help|help]   (git passes no arguments)
# Bypass once, deliberately: git commit --no-verify
set -uo pipefail
case "${1:-}" in -h|--help|help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" | sed '/^set /d'; exit 0;; esac
if command -v lmx >/dev/null 2>&1; then
	LEMMAX_NO_CHAIN=1 lmx hook pre-commit || exit 1
fi
own="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$own" ] && [ "$(readlink -f "$own")" != "$(readlink -f "$0")" ]; then
	exec "$own" "$@"
fi
exit 0
