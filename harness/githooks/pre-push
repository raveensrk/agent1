#!/usr/bin/env python3
"""pre-push: keep a repo marked private off any remote not allowed for it.

A repo holding private data (health records, finances) opts in once:
  git config repo.private true
  git config --add repo.allowRemote <url>     # one line per allowed remote
Then every push to a URL not in repo.allowRemote is refused. A GitHub URL
must also be a private repo, checked with `gh api`; when gh cannot answer,
the push is refused, since an unchecked push of private data cannot be undone.
A repo without repo.private is never touched.

Runs for every repo through the global core.hooksPath, which points here:
  git config --global core.hooksPath ~/repos/agent1/harness/githooks
A global hooksPath hides each repo's .git/hooks, so a repo's own
.git/hooks/pre-push, when there is one, is run after this check.

  pre-push REMOTE URL    (git passes these, and the refs on stdin)
  pre-push -h | --help | help
Bypass once, deliberately: git push --no-verify
"""
import os
import re
import subprocess
import sys

# owner/repo from https://github.com/o/r(.git) or git@github.com:o/r(.git)
GITHUB = re.compile(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$")


def config(*args):
    """git config output lines, empty when the key is unset."""
    run = subprocess.run(["git", "config", *args], capture_output=True, text=True)
    return run.stdout.split() if run.returncode == 0 else []


def github_private(url):
    """True or False for a GitHub URL's visibility; None when gh cannot tell."""
    found = GITHUB.search(url)
    if not found:
        return None
    try:
        run = subprocess.run(
            ["gh", "api", f"repos/{found.group(1)}/{found.group(2)}", "--jq", ".private"],
            capture_output=True, text=True, timeout=20,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if run.returncode != 0:
        return None
    return run.stdout.strip() == "true"


def refusal(url):
    """Why a push to URL is refused, or None when it may go ahead."""
    if config("--bool", "repo.private") != ["true"]:
        return None
    if url not in config("--get-all", "repo.allowRemote"):
        return (
            f"{url} is not an allowed remote for this private repo.\n"
            f"fix, only if that remote is private: git config --add repo.allowRemote {url}"
        )
    if GITHUB.search(url):
        private = github_private(url)
        if private is None:
            return f"could not confirm {url} is private (gh api failed); run gh auth status"
        if not private:
            return f"{url} is a public GitHub repo; make it private first"
    return None


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip() if argv[0] == "help" else __doc__.split("\n\n")[0])
        return 0
    if len(argv) != 2:
        print("usage: pre-push REMOTE URL (see pre-push --help)", file=sys.stderr)
        return 2
    refs = sys.stdin.read()
    reason = refusal(argv[1])
    if reason:
        print("push refused: repo.private is set", file=sys.stderr)
        print(reason, file=sys.stderr)
        return 1
    # Chain to the repo's own pre-push hook, which the global path hides.
    git_dir = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True, text=True).stdout.strip()
    local = os.path.join(git_dir, "hooks", "pre-push") if git_dir else ""
    if local and os.access(local, os.X_OK) and os.path.realpath(local) != os.path.realpath(__file__):
        return subprocess.run([local, *argv], input=refs, text=True).returncode
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
