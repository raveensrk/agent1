#!/usr/bin/env bash
# install - put reqtrace on PATH as ~/.local/bin/reqtrace, a wrapper script, not a link.
# usage: harness/reqtrace/install [-h|--help]
# example: bash harness/reqtrace/install
set -euo pipefail
case "${1:-}" in -h|--help|help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" | sed '/^set /d'; exit 0;; esac
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
mkdir -p "$HOME/.local/bin"
printf '#!/usr/bin/env bash\n# reqtrace: written by %s/install; runs that checkout.\nexec "%s/reqtrace" "$@"\n' "$here" "$here" > "$HOME/.local/bin/reqtrace"
chmod +x "$HOME/.local/bin/reqtrace"
echo "installed: $HOME/.local/bin/reqtrace"
