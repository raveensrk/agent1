#!/usr/bin/env bash
# harness-check: self_check - the suites and the full-population lint, one line each.
#
# The batch a session runs after touching the harness, typed by hand ten times in
# one review as a chained command (9-12s each). The exit code is lint's verdict:
# 0 clean, 1 findings, 2 a check failed to run.
#
# usage: harness/self_check [-h|--help]
# Runs harness/tests/test_lint.py and test_install_lib.py under pytest, every
# harness/tests/*.ts suite (180 s cap each), then lint.py --repos over every git
# repo under ~/repos. Reads those repos; writes nothing but pytest's cache.
# example: bash harness/self_check
set -uo pipefail
case "${1:-}" in -h|--help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0;; esac

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python3 -m pytest "$here/tests/test_lint.py" "$here/tests/test_install_lib.py" -q 2>&1 | tail -1
for suite in "$here"/tests/*.ts; do
	timeout 180 node --experimental-strip-types "$suite" 2>&1 | tail -1
done
python3 "$here/lint.py" --repos 2>&1 | tail -1
