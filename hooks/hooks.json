{
  "description": "agent1 harness: the pi extensions' guards, lint, nudge and rules, through harness/hook.ts",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/harness/hook.ts\" rules",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/harness/hook.ts\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/harness/hook.ts\" nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/harness/hook.ts\" nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"${CLAUDE_PLUGIN_ROOT}/harness/hook.ts\" lint",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
