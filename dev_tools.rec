%rec: Node
%key: Name
%type: Group rec Group
%type: Pos regexp /^-?[0-9]+ -?[0-9]+$/
%mandatory: Name
%allowed: Name Tag Url Note Group Pos Kind Size Fit Text
%graph: label Name
%graph: tag Tag
%graph: color Tag
%graph: group Group
%graph: pos Pos
