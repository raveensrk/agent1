{:paths ["src" "build"]
 :deps {cljfx/cljfx {:mvn/version "1.10.363"}
        ;; cljfx pins an early-access JavaFX 22; use the current release.
        org.openjfx/javafx-base {:mvn/version "27.0.1"}
        org.openjfx/javafx-graphics {:mvn/version "27.0.1"}
        org.openjfx/javafx-controls {:mvn/version "27.0.1"}}
 :aliases {:run {:main-opts ["-m" "demo.button"]
                 :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The window demo: tabs, several windows, panes.
           :window {:main-opts ["-m" "demo.window"]
                    :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The window checks: opens the real window for 8 s.
           :check {:extra-paths ["test"]
                   :main-opts ["-m" "demo.window-check"]
                   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The window demo's checks: opens real windows for 15 s.
           :check-window {:extra-paths ["test"]
                          :main-opts ["-m" "demo.window-page-check"]
                          :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The slider demo: two sliders over what one of them sets.
           :slider {:main-opts ["-m" "demo.slider-page"]
                    :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The slider's window checks: opens the real window for 40 s, behind
           ;; whatever is in front; it takes neither the keyboard nor the pointer.
           :check-slider {:extra-paths ["test"]
                          :main-opts ["-m" "demo.slider-check"]
                          :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                     "-Dglass.taskbarApplication=false"]}
           ;; The time picker demo: three time pickers.
           :time-picker {:main-opts ["-m" "demo.time-picker-page"]
                         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The time picker's window checks: opens the real window for 40 s,
           ;; behind whatever is in front; it takes neither the keyboard nor the
           ;; pointer.
           :check-time-picker {:extra-paths ["test"]
                               :main-opts ["-m" "demo.time-picker-check"]
                               :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                          "-Dglass.taskbarApplication=false"]}
           ;; The date picker demo: three date pickers.
           :date-picker {:main-opts ["-m" "demo.date-picker-page"]
                         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The date picker's window checks: opens the real window for 40 s,
           ;; behind whatever is in front; it takes neither the keyboard nor the
           ;; pointer.
           :check-date-picker {:extra-paths ["test"]
                               :main-opts ["-m" "demo.date-picker-check"]
                               :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                          "-Dglass.taskbarApplication=false"]}
           ;; The scroll demo: areas inside a page that scrolls.
           :scroll {:main-opts ["-m" "demo.scroll-page"]
                    :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; The scroll areas' window checks: opens the real window for 60 s,
           ;; behind whatever is in front; it takes neither the keyboard nor the
           ;; pointer, and changes none of macOS's settings.
           :check-scroll {:extra-paths ["test"]
                          :main-opts ["-m" "demo.scroll-check"]
                          :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                     "-Dglass.taskbarApplication=false"]}
           ;; About's build step: writes build/demo/build.edn from
           ;; VERSION and the commit HEAD names. Run it before :version.
           :stamp {:extra-paths ["tools"]
                   :main-opts ["-m" "stamp"]}
           ;; The About demo: a main window, and About in the app menu.
           :version {:main-opts ["-m" "demo.version-page"]
                     :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
           ;; About's window checks: builds build.edn first, then
           ;; opens the real windows for 10 s, behind whatever is in front; it
           ;; takes neither the keyboard nor the pointer, and puts back what
           ;; was on the clipboard.
           :check-version {:extra-paths ["test" "tools"]
                           :main-opts ["-m" "demo.version-check"]
                           :jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                      "-Dglass.taskbarApplication=false"]}
           ;; No test draws, so JavaFX is never started: no Dock icon, no toolkit.
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner" "-n" "demo.button-test" "-n" "demo.window-test"
                              "-n" "demo.slider-test" "-n" "demo.time-picker-test" "-n" "demo.date-picker-test"
                              "-n" "demo.scroll-test" "-n" "demo.version-test"]
                  :jvm-opts ["-Dcljfx.skip-javafx-initialization=true"
                             "--enable-native-access=ALL-UNNAMED"]}}}
