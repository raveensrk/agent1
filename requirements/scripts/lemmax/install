#!/usr/bin/env bash
# install - put lemmax on PATH as ~/.local/bin/lemmax, a wrapper script, not a link.
# usage: requirements/scripts/lemmax/install [-h|--help]
# example: bash requirements/scripts/lemmax/install
# lemma: 01a1ff25-116d-73f1-a45e-dd77e482a983
set -euo pipefail
case "${1:-}" in -h|--help|help) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0" | sed '/^set /d'; exit 0;; esac
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
mkdir -p "$HOME/.local/bin"
printf '#!/usr/bin/env bash\n# lemmax: written by %s/install; runs that checkout.\nexec "%s/lemmax" "$@"\n' "$here" "$here" > "$HOME/.local/bin/lemmax"
chmod +x "$HOME/.local/bin/lemmax"
# The old name stops working: lemmax replaced reqtrace.
rm -f "$HOME/.local/bin/reqtrace"
echo "installed: $HOME/.local/bin/lemmax"
