# Ishikari as a step-by-step flowchart: one start, one end, a diamond per
# decision. Render: render.sh. No fixed colors, so the dark theme just works.

direction: down

classes: {
  step: {shape: rectangle}
  ask: {shape: diamond}
  you: {style.stroke-width: 3; style.bold: true}
  stop: {shape: oval}
}

start: Start: you give a task {class: stop}

# ---- Plan: the only part where you are asked ----
facts: Missing facts? {class: ask}
research: Researcher ants\nsearch web + computer {class: step}
more: More to ask? {class: ask}
ask: Investigator asks you\nONE question {class: [step; you]}
report: Investigator writes\ninvestigation_report.md {class: step}
req: Add requirement ant\nwrites the requirement {class: step}
arch: Architect ant writes\narchitecture.md + plans {class: step}

start -> facts
facts -> research: yes
research -> facts
facts -> more: no
more -> ask: yes
ask -> facts: your answer
more -> report: no
report -> req
req -> arch

# ---- Build, check, fix: per task, in parallel ----
build: Worker ants build\neach task {class: step}
inspect: Inspector: task OK? {class: ask}
tries: Under 3 tries\non this bug? {class: ask}
fix: Detective plans fix,\nworker builds it {class: step}
drop: Drop task\n(and tasks built on it) {class: step}

arch -> build
build -> inspect
inspect -> tries: no
tries -> fix: yes
fix -> inspect
tries -> drop: no

# ---- Combined test, merge, check ----
combined: Combined test:\npassing tasks work together? {class: ask}
clash: Fix the clashing\ntasks {class: step}
merge: Merger: merge OK? {class: ask}
rounds: Under 2 extra\nbuild rounds? {class: ask}
again: Build round for\nfailed merges {class: step}
check: App check passes? {class: ask}
once: First check\nfailure? {class: ask}
fixcheck: One fix round {class: step}
main: Upkeep ants run,\nmain moves forward {class: step}
done: Requirements\nmarked done {class: step}
end: End: one report {class: stop}

inspect -> combined: yes
drop -> combined
combined -> clash: no
clash -> inspect
combined -> merge: yes
merge -> rounds: no
rounds -> again: yes
again -> merge
rounds -> main: no, drop the rest
merge -> main: yes
main -> check
check -> once: no
once -> fixcheck: yes
fixcheck -> check
once -> end: no, stop
check -> done: yes
done -> end
